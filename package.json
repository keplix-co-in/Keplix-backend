{
  "name": "keplix-backend-node",
  "version": "1.0.0",
  "description": "Node.js backend for Keplix",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:web": "RUN_WORKERS=false node server.js",
    "start:worker": "RUN_WORKERS=true node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathIgnorePatterns tests/e2e",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio --port 5000",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest tests/e2e --runInBand --forceExit",
    "test:all": "npm run test && npm run test:e2e"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.0",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@fluidjs/multer-cloudinary": "^1.0.4",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.0",
    "file-type": "^21.3.4",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.18.0",
    "razorpay": "^2.9.6",
    "resend": "^6.8.0",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.11.2",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^4.3.5"
  },
  "overrides": {
    "ws": ">=8.21.3",
    "websocket-driver": ">=0.7.5",
    "engine.io": ">=6.6.10",
    "protobufjs": "~7.6.6",
    "@protobufjs/utf8": ">=1.1.2",
    "axios": ">=1.20.0",
    "lodash": ">=4.18.1",
    "fast-xml-parser": ">=5.11.1",
    "form-data": ">=4.0.6",
    "path-to-regexp": "0.1.13",
    "@grpc/grpc-js": ">=1.14.4",
    "socket.io-parser": ">=4.2.7",
    "swagger-jsdoc": {
      "brace-expansion": "1.1.18",
      "js-yaml": "4.3.2"
    }
  }
}
