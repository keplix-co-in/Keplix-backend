# Environment Configuration for Keplix Backend
# Copy this file to .env and fill in your actual values.
#
# Required-in-production (Y/N) below reflects config/env.js's
# REQUIRED_IN_PRODUCTION list exactly -- if it says Y, boot fails loudly and
# names the missing var when NODE_ENV=production and it's unset. If it says
# N, the app boots regardless, either because the var is genuinely optional
# or because an existing call site already degrades gracefully when it's
# absent (noted per variable below).
#
# Rebuilt 2026-09-14 from an actual grep of every process.env.* read in the
# codebase (excluding node_modules and tests), cross-referenced against
# config/env.js -- the previous version of this file listed variables the
# code does not read (STRIPE_SECRET_KEY, CLOUDINARY_CLOUD_NAME/API_KEY/
# API_SECRET) and was missing about a dozen the code actually requires.

# --- Core -------------------------------------------------------------

# Required: Y. Postgres connection string.
DATABASE_URL="postgresql://username:password@localhost:5432/keplix"

# Only needed if you run the bundled db service via docker-compose.yml --
# it reads these to set up that container's Postgres user/db/password.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="keplix"

# Required: Y. Signs user/admin access tokens (config/env.js requires
# min length 32; enforced at all NODE_ENV, not just production).
JWT_SECRET="a-real-random-secret-at-least-32-characters-long"

# Required: N. Falls back to JWT_SECRET with a console.warn if unset
# (controllers/authController.js). Set a DIFFERENT value in production --
# sharing one secret between access and refresh tokens is a real weakening,
# it is just not currently enforced as a hard boot failure.
JWT_REFRESH_SECRET="a-different-real-random-secret-at-least-32-characters"

NODE_ENV="development"
PORT=8080

# --- CORS ---------------------------------------------------------------

# NOT CURRENTLY READ BY THE CODE. util/cors.js's allowed-origins list is
# hardcoded (keplix.co.in, admin.keplix.co.in, localhost:5173/5174/8000,
# plus a regex for *.vercel.app and *.keplix.co.in subdomains) -- setting
# this has no effect. Kept here so it isn't silently dropped from
# deploy.yml's --set-env-vars without anyone noticing; either wire it up
# for real (append its comma-separated origins to the hardcoded list) or
# remove it from the deploy secret. Found while rebuilding this file
# (2026-09-14) -- not a documented audit finding before now.
# ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# --- Razorpay (customer payments) ---------------------------------------

# Required: Y (all three below)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
# util/webhookVerification.js explicitly rejects the literal placeholder
# value "your_razorpay_webhook_secret_here" -- use a real value, even in
# dev, or the webhook handler 500s by design rather than verifying nothing.

# --- RazorpayX (vendor payouts) ------------------------------------------

# Required: Y (all three below)
RAZORPAYX_KEY_ID="rzp_test_..."
RAZORPAYX_KEY_SECRET="your-razorpayx-secret"
RAZORPAYX_ACCOUNT_NUMBER="your-razorpayx-account-number"

# NOT CURRENTLY READ BY THE CODE, despite being deployed as a secret in
# deploy.yml's job-level `env:` (not the --set-env-vars line, so it never
# actually reaches the running container either). No file in this repo
# references it. Same "wire it up or remove it" note as ALLOWED_ORIGINS.
# RAZORPAYX_WEBHOOK_SECRET="your-razorpayx-webhook-secret"

# --- Email (Resend) -------------------------------------------------------

# Required: N. util/communication.js warns and skips sending when unset --
# a working degradation, not a crash.
RESEND_API_KEY="re_..."
# Required: N. Falls back to 'Keplix <noreply@keplix.co.in>' when unset.
EMAIL_FROM="Keplix <noreply@keplix.co.in>"

# --- SMS/WhatsApp (Twilio) ------------------------------------------------

# Required: N for all Twilio vars. util/communication.js and
# services/walkInNotificationService.js already check for these and log a
# warning + skip the send when absent -- SMS/WhatsApp becomes a no-op, the
# rest of the app keeps running.
TWILIO_ACCOUNT_SID="AC..."
# Twilio accepts EITHER the classic auth token OR an API key SID+secret
# pair (still combined with TWILIO_ACCOUNT_SID above) -- see
# util/communication.js's getTwilioClient for which one wins when both are set.
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_API_KEY_SID="SK..."
TWILIO_API_KEY_SECRET="your-twilio-api-key-secret"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_FROM="whatsapp:+1234567890"
# DLT-registered template SID for the walk-in job-sheet WhatsApp message.
# Changing the underlying message wording requires re-registering the
# template with the DLT operator FIRST -- an unregistered change is
# silently dropped by Indian carriers. See
# services/walkInNotificationService.js's comment on this exact constraint.
TWILIO_WHATSAPP_WALKIN_TEMPLATE_SID="HX..."

# --- Firebase (push notifications, Google login audience) ----------------

# Required: Y. Comma-separated list of Google OAuth client IDs allowed to
# sign in. THIS EXACT VAR being unset in production is what caused Google
# login to 500 in a live incident -- see config/env.js and TODO.md.
GOOGLE_ALLOWED_AUDIENCES="357379210332-xxxxxxxx.apps.googleusercontent.com"

# Required: N. util/firebase.js falls back to a local serviceAccountKey.json
# file if this is unset, and warns + disables push if neither is present --
# a working degradation. Base64-encoded service account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64="base64-encoded-service-account-json"

# --- Cloudinary (uploads) --------------------------------------------------

# Required: Y. A SINGLE connection-string URL
# (cloudinary://<api_key>:<api_secret>@<cloud_name>), not three separate
# vars -- util/cloudinary.js reads exactly this one.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# --- URLs used to build links in emails/SMS -------------------------------

# Required: Y. Used with NO fallback to build password-reset links
# (controllers/authController.js) -- unset in production previously shipped
# "undefined/reset-password/..." to a user's inbox. See config/env.js.
FRONTEND_URL="http://localhost:8081"

# Required: N. services/walkInNotificationService.js falls back to
# 'https://keplix.co.in' when unset.
PUBLIC_WEB_BASE_URL="https://keplix.co.in"

# --- Rate limiting (all optional, sane defaults shown) --------------------

# Every RATE_LIMIT_* var below is optional; the default column is the
# actual fallback in config/env.js, reproducing the previously-hardcoded
# app.js behaviour exactly if none of these are set.
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes, default
RATE_LIMIT_MAX=1000           # default
RATE_LIMIT_AUTH_MAX=40        # default
RATE_LIMIT_AUTHED_MAX=600     # default

# --- Background workers ----------------------------------------------------

# Required: N. See server.js -- "true" runs this process as a worker
# (cron dispatch), "false" runs it as the web server only. Unset runs both
# in one process, which is the default/local-dev shape.
RUN_WORKERS="false"

# Required: N. util/bookingStatusManager.js does
# `process.env.BOOKING_PENDING_TIMEOUT_MINUTES || 5` -- default 5 if unset.
BOOKING_PENDING_TIMEOUT_MINUTES=5

# Required: N. services/walkInNotificationService.js does
# `process.env.NOTIFY_BOTH_CHANNELS !== 'false'` -- defaults to true
# (send both WhatsApp and SMS) unless explicitly set to the string "false".
NOTIFY_BOTH_CHANNELS="true"

# --- Docs -------------------------------------------------------------

# Required: N. Swagger/API docs are served in every non-production
# NODE_ENV automatically. Set to "true" to deliberately expose them on a
# deployed/production instance too (app.js).
# EXPOSE_API_DOCS="true"

# Required: N. Base URL Swagger UI's "Try it out" sends requests to
# (config/swagger.js). Falls back to http://localhost:$PORT if unset, which
# is wrong for a deployed instance -- set this to the real public API origin
# there (e.g. the Cloud Run service URL).
# API_BASE_URL="https://api.keplix.co.in"

# --- Seed script only (scripts/seed.js / prisma/seed.js), never read by the running app ---

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="change-me-before-running-the-seed-script"
SEED_ADMIN_PHONE="+910000000000"
SEED_PASSWORD="change-me-before-running-the-seed-script"

# --- Migrations only, not read by the running app (see prisma.config.js and
# .github/workflows/deploy.yml's "Apply database schema" step) -----------

# Must be the Supabase POOLER host (aws-1-ap-south-1.pooler.supabase.com),
# port 5432 (session mode, not 6543/transaction mode), no ?pgbouncer=true.
# The direct host (db.<ref>.supabase.co) publishes only an AAAA record and
# is unreachable from GitHub-hosted runners, which have no IPv6 egress --
# see the long comment in deploy.yml for the full story.
# MIGRATION_DATABASE_URL="postgresql://user:pass@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Browser push for the vendor portal (optional) --------------------------
# Generate once with:  npx web-push generate-vapid-keys
# Leave unset to disable browser alerts; nothing else is affected. The PUBLIC key
# must also be set on the portal as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:info@keplix.co.in"
